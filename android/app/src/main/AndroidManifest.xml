<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ler a pasta do Victoria 2 escolhida pelo usuario por caminho de arquivo
         (o C++ usa open/mmap); o usuario concede em Configuracoes -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- multiplayer -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GLES 3.2 (o jogo usa draw indirect e texturas multisample) -->
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />

    <!-- AliceActivity (NativeActivity) carrega a libAlice.so e chama android_main;
         o Java so cuida de permissao, seletor de pasta e mensagens -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".AliceActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|density|uiMode">

            <meta-data android:name="android.app.lib_name" android:value="Alice" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
